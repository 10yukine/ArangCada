# Font files never change under the same name (give the file a new name if
# Fredoka is ever regenerated), so browsers may keep them for a year instead
# of re-checking on every page view.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The page is not meant to be embedded, and its address carries the share
# token, so no request it makes may send that address on as a referrer (the
# page's own <meta name="referrer"> says the same).
#
# Content-Security-Policy: scripts come from this site and the pinned map
# library on unpkg only, and nothing inline runs. connect-src stays open to any
# https host because the Supabase project and the map provider are chosen at
# deploy time (build-config.js); the map draws its tiles in a blob: worker.
# Cloudflare Web Analytics is deliberately not allowed here: its beacon would
# report this page's address, which carries the share token.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self' https://unpkg.com; style-src 'self' https://unpkg.com; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https:; worker-src blob:; child-src blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
