# Cloudflare Workers static-asset security headers for the admin dashboard.
# Flutter copies this file into build/web, the assets directory in wrangler.jsonc.

# The Content-Security-Policy is enforced. It ran report-only first; on
# 5 Oct 2026 every signed-in screen was walked on the live site and the only
# thing it would have blocked was Cloudflare's own analytics script, which is
# now listed. Before adding a script, style or host to the console, add it
# here, or the browser will refuse it.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
