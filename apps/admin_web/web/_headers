# Cloudflare Workers static-asset security headers for the admin dashboard.
# Flutter copies this file into build/web, the assets directory in wrangler.jsonc.

# The Content-Security-Policy below is report-only: the browser logs what it
# would block and blocks nothing. Sign in, walk every screen with the browser
# console open, and only when it stays quiet rename the header to
# Content-Security-Policy.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
