# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
*.env
.env.*
env.json
# Credential staging. The directory contents are ignored, but *.example
# templates are tracked so a new machine knows which keys are needed without
# ever seeing a value.
secrets/*
!secrets/*.example
supabase/.temp/
supabase/.branches/

# Signing keys and platform credentials.
# apps/mobile/android/.gitignore already covers the Flutter module; these are
# repo-wide so a future module (apps/admin_web, packages/*) cannot slip one in.
*.jks
*.keystore
key.properties
local.properties
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Map/routing provider keys. SECURITY.md allows development-tier MapTiler and
# openrouteservice keys in the client, but never committed to Git.
**/maptiler_key*
**/ors_key*
**/*api_key*
**/*.secret

# ---------------------------------------------------------------------------
# Local agent tooling — machine config, not project state
# ---------------------------------------------------------------------------
.claude/
.agents/
.mcp.json
skills-lock.json

# ---------------------------------------------------------------------------
# Flutter / Dart
# ---------------------------------------------------------------------------
build/
.dart_tool/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.symbols
app.*.map.json

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/settings.json

# ---------------------------------------------------------------------------
# Logs and OS noise
# ---------------------------------------------------------------------------
*.log
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Local build artifacts (APKs are large and rebuildable; never version them)
# ---------------------------------------------------------------------------
dist/

# Public tracking page config: holds the MapTiler key and the Supabase anon key.
# The .example template is tracked; the real file is not.
apps/track_web/public/config.js

# Cloudflare Wrangler local state and build cache (track_web / admin_web deploys)
.wrangler/

# Private working notes and device evidence: retained locally, excluded from handover.
/MEMORY_SETUP.md
/MULTI_AGENT_REVIEW.md
/PROJECT_BRIEF.md
/PROMPTS.md
/ROADMAP.md
/SAFETY.md
/TOOLS.md
/design-qa.md
/.pipeline/
/.codex-evidence/
/design-plans/
/research/
/screen_*.png
/ui_*.xml

# Local reference archive and optional developer tooling.
/CLAUDE.md
/.mcp.json.example
/scripts/md_to_pdf.py
/scripts/setup_paymongo_keys.ps1
/apps/admin_web/design-qa.md
/docs/
/scripts/check_agent_config.py
/secrets/providers.local.json.example

# Local agent notes (kept on the owner's machine only)
/AGENTS.md

__pycache__/
*.pyc
