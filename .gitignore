# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
*.env
.env.*
env.json
# Credential staging. The directory contents are ignored, but *.example
# templates are tracked so a new machine knows which keys are needed without
# ever seeing a value.
secrets/*
!secrets/*.example
supabase/.temp/
supabase/.branches/

# Signing keys and platform credentials.
# apps/mobile/android/.gitignore already covers the Flutter module; these are
# repo-wide so a future module (apps/admin_web, packages/*) cannot slip one in.
*.jks
*.keystore
key.properties
local.properties
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Map/routing provider keys. SECURITY.md allows development-tier MapTiler and
# openrouteservice keys in the client, but never committed to Git.
**/maptiler_key*
**/ors_key*
**/*api_key*
**/*.secret

# ---------------------------------------------------------------------------
# Local agent tooling — machine config, not project state
# ---------------------------------------------------------------------------
.claude/
.agents/
.mcp.json
skills-lock.json

# ---------------------------------------------------------------------------
# Large binaries kept locally rather than in Git history
# ---------------------------------------------------------------------------
# docs/legacy/ holds superseded document revisions (currently a 5 MB PDF of
# SRS v1.1). Binaries never leave Git history once committed, so archive them
# outside the repo. Commit deliberately, or use Git LFS, if one must ship.
docs/legacy/

# ---------------------------------------------------------------------------
# Flutter / Dart
# ---------------------------------------------------------------------------
build/
.dart_tool/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.symbols
app.*.map.json

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/settings.json

# ---------------------------------------------------------------------------
# Logs and OS noise
# ---------------------------------------------------------------------------
*.log
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Local build artifacts (APKs are large and rebuildable; never version them)
# ---------------------------------------------------------------------------
dist/

# Public tracking page config: holds the MapTiler key and the Supabase anon key.
# The .example template is tracked; the real file is not.
apps/track_web/public/config.js

# Cloudflare Wrangler local state and build cache (track_web / admin_web deploys)
.wrangler/

# Private working notes and device evidence: retained locally, excluded from handover.
/MEMORY_SETUP.md
/MULTI_AGENT_REVIEW.md
/PROJECT_BRIEF.md
/PROMPTS.md
/ROADMAP.md
/SAFETY.md
/TOOLS.md
/design-qa.md
/docs/AGENT_TOOLING.md
/docs/CLAUDE_CODE_CODEX_HANDOFF.md
/docs/CLIENT_MEETING_QUESTIONS.md
/docs/CODEX_SETUP.md
/docs/COMPETITOR_TECH_DECISIONS.md
/docs/DESIGN_TARGET.md
/docs/FARE_STRATEGY_DEFENSE.md
/docs/GRAPHIFY_OBSIDIAN_SETUP.md
/docs/KNOWN_ADVISOR_FINDINGS.md
/docs/LLM_WIKI.md
/docs/MEMORY_SETUP.md
/docs/MULTI_AGENT_REVIEW.md
/docs/PROJECT_DECISIONS.md
/docs/SRS.md
/docs/MOBILE_APP_WORKFLOW.md
/docs/MOBILE_UI_EXPLORATION_GUIDE.md
/.pipeline/
/.codex-evidence/
/design-plans/
/research/
/docs/audits/
/docs/figma/
/docs/research/
/docs/review/
/docs/ui/
/screen_*.png
/ui_*.xml
